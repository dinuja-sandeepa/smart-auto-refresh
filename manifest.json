{
    "manifest_version": 3,
    "name": "Smart Auto Refresh",
    "version": "1.0",
    "description": "Auto refresh tabs with custom intervals and controls.",
    "permissions": [
        "tabs",
        "storage",
        "alarms",
        "activeTab",
        "scripting"
    ],
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/Ghost16.png",
            "32": "icons/Ghost32.png",
            "48": "icons/Ghost48.png",
            "128": "icons/Ghost128.png"
        }
    },
    "icons": {
        "16": "icons/Ghost16.png",
        "32": "icons/Ghost32.png",
        "48": "icons/Ghost48.png",
        "128": "icons/Ghost128.png"
    }
}